---
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';
import type { Service } from '~/data/services';
import { whatsappLink } from '~/data/contact';

/**
 * Tarjeta individual de servicio (estilo pricing).
 * `featured` resalta el borde para los planes de video destacados.
 * El botón solo se muestra si el servicio define `ctaText`.
 */
interface Props {
  service: Service;
  featured?: boolean;
}

const { service, featured = false } = Astro.props;
const { icon, title, tagline, badge, highlight, price, period, note, ctaText, items } = service;
---

<div
  class:list={[
    'flex h-full flex-col rounded-3xl bg-white/70 p-6 shadow-sm ring-1 backdrop-blur sm:p-8 dark:bg-slate-900/50',
    highlight
      ? 'ring-2 ring-primary dark:ring-primary/70'
      : featured
        ? 'ring-2 ring-primary/50 dark:ring-primary/40'
        : 'ring-black/5 dark:ring-white/10',
  ]}
>
  {
    badge && (
      <span
        class:list={[
          'mb-4 inline-flex w-fit items-center rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wide',
          highlight ? 'bg-primary text-white' : 'bg-primary/15 text-primary dark:bg-primary/25 dark:text-pink-100',
        ]}
      >
        {badge}
      </span>
    )
  }

  <div class="flex items-center gap-3">
    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-primary text-white">
      <Icon name={icon} class="h-6 w-6" />
    </span>
    <h3 class="font-heading text-xl font-bold tracking-tight text-heading dark:text-white">{title}</h3>
  </div>

  {tagline && <p class="mt-2 text-sm text-muted dark:text-slate-300">{tagline}</p>}

  <div class="mt-6 border-t border-black/5 pt-6 dark:border-white/10">
    {
      price ? (
        <div>
          <div class="flex flex-wrap items-baseline gap-2">
            <span class="font-heading text-4xl font-extrabold tracking-tight text-heading dark:text-white">
              {price}
            </span>
            {period && <span class="text-sm text-muted">{period}</span>}
          </div>
          {note && <p class="mt-2 text-xs text-muted">{note}</p>}
        </div>
      ) : (
        <div>
          <span class="font-heading text-3xl font-extrabold tracking-tight text-primary dark:text-pink-200">
            A medida
          </span>
          <p class="mt-1 text-sm text-muted">Cotización personalizada según alcance</p>
        </div>
      )
    }
  </div>

  <ul class="mt-6 flex-1 space-y-3">
    {
      items.map((item) => (
        <li class="flex items-start gap-3">
          <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/15 text-primary dark:bg-primary/25 dark:text-pink-100">
            <Icon name="tabler:check" class="h-3.5 w-3.5" />
          </span>
          <span class="text-sm text-default dark:text-slate-200">{item}</span>
        </li>
      ))
    }
  </ul>

  {
    ctaText && (
      <div class="mt-8">
        <Button variant="primary" href={whatsappLink} target="_blank" icon="tabler:arrow-right" class="w-full">
          {ctaText}
        </Button>
      </div>
    )
  }
</div>
