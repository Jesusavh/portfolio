---
import { Icon } from 'astro-icon/components';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { experience } from '~/data/experience';

/**
 * Experiencia laboral: grid de tarjetas con las marcas gestionadas, el rubro
 * de cada una y el alcance del trabajo. Cada tarjeta incluye una mini-galería
 * adaptativa de publicaciones (Instagram) con lightbox integrado.
 *
 * Lógica adaptativa de la galería:
 *  - 0 imágenes: se omite la galería (tarjeta compacta).
 *  - 1 imagen: grid-cols-1. 2 imágenes: grid-cols-2. 3 imágenes: grid-cols-3.
 *  - Más de 3: se muestran las 2 primeras + una 3ª con overlay "+N más".
 */
interface Props {
  id?: string;
  tagline?: string;
  title?: string;
  subtitle?: string;
}

const { id = 'experiencia', tagline = 'Experiencia', title, subtitle } = Astro.props;

const galleryOf = (images: string[] = []) => {
  const count = images.length;
  if (count === 0) return null;
  const cols = count === 1 ? 'grid-cols-1' : count === 2 ? 'grid-cols-2' : 'grid-cols-3';
  const hasMore = count > 3;
  return {
    cols,
    preview: hasMore ? images.slice(0, 3) : images,
    more: hasMore ? count - 3 : 0,
  };
};
---

<WidgetWrapper id={id} containerClass="max-w-6xl">
  <Headline
    tagline={tagline}
    title={title ?? 'Marcas que confiaron en mí'}
    subtitle={subtitle ?? 'Gestión integral de redes y contenido para negocios de distintos rubros.'}
  />

  <div class="mx-auto grid max-w-6xl gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      experience.map(({ company, sector, icon, description, images = [] }, index) => {
        const gallery = galleryOf(images);
        return (
          <article
            class="flex flex-col rounded-3xl bg-white/70 p-6 shadow-sm ring-1 ring-black/5 sm:p-7 dark:bg-slate-900/50 dark:ring-white/10 intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
            style={`animation-delay: ${(index % 3) * 90}ms`}
          >
            <div class="flex items-center gap-3">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-primary text-white">
                <Icon name={icon} class="h-6 w-6" />
              </span>
              <div class="min-w-0">
                <h3 class="truncate font-heading text-lg font-bold tracking-tight text-heading dark:text-white">
                  {company}
                </h3>
                <span class="rounded-full bg-primary/10 px-2.5 py-0.5 text-[0.7rem] font-semibold uppercase tracking-wide text-primary dark:bg-primary/20 dark:text-pink-100">
                  {sector}
                </span>
              </div>
            </div>

            <p class="mt-4 text-sm leading-relaxed text-muted dark:text-slate-300">{description}</p>

            {gallery && (
              <aw-brand-gallery data-images={JSON.stringify(images)} class="mt-5">
                <div class:list={['grid gap-2', gallery.cols]}>
                  {gallery.preview.map((src, i) => (
                    <button
                      type="button"
                      data-aw-brand-open={i}
                      aria-label={`Ver publicación ${i + 1} de ${company}`}
                      class="group relative aspect-square overflow-hidden rounded-lg bg-gray-100 ring-1 ring-black/5 dark:bg-slate-800 dark:ring-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                    >
                      <img
                        src={src}
                        alt={`${company} – publicación ${i + 1}`}
                        loading="lazy"
                        decoding="async"
                        class="absolute inset-0 h-full w-full object-cover transition duration-300 group-hover:scale-105"
                      />
                      {gallery.more > 0 && i === gallery.preview.length - 1 && (
                        <span class="absolute inset-0 flex items-center justify-center bg-black/60 backdrop-blur-sm">
                          <span class="font-heading text-sm font-bold text-white sm:text-base">
                            +{gallery.more} más
                          </span>
                        </span>
                      )}
                    </button>
                  ))}
                </div>

                <dialog
                  aria-label={`Galería de ${company}`}
                  class="m-auto max-h-[92vh] max-w-[92vw] rounded-2xl bg-black/90 p-3 text-white backdrop:bg-black/70 backdrop:backdrop-blur-sm open:flex open:flex-col sm:p-4"
                >
                  <form method="dialog" class="absolute right-3 top-3 z-10">
                    <button
                      type="submit"
                      class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20"
                      aria-label="Cerrar"
                    >
                      <Icon name="tabler:x" class="h-5 w-5" />
                    </button>
                  </form>
                  <button
                    type="button"
                    data-aw-brand-prev
                    class="absolute left-3 top-1/2 z-10 inline-flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20"
                    aria-label="Anterior"
                  >
                    <Icon name="tabler:chevron-left" class="h-5 w-5" />
                  </button>
                  <button
                    type="button"
                    data-aw-brand-next
                    class="absolute right-3 top-1/2 z-10 inline-flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20"
                    aria-label="Siguiente"
                  >
                    <Icon name="tabler:chevron-right" class="h-5 w-5" />
                  </button>
                  <img data-aw-brand-img class="max-h-[78vh] w-auto rounded-lg object-contain" alt="" />
                  <div class="mt-3 flex items-center justify-center gap-2 text-sm">
                    <span class="font-medium text-white">{company}</span>
                    <span class="text-white/60" data-aw-brand-counter />
                  </div>
                </dialog>
              </aw-brand-gallery>
            )}
          </article>
        );
      })
    }
  </div>
</WidgetWrapper>

<style>
  aw-brand-gallery {
    display: block;
  }
</style>

<script>
  class AwBrandGallery extends HTMLElement {
    connectedCallback() {
      const dialog = this.querySelector<HTMLDialogElement>('dialog');
      if (!dialog) return;

      let images: string[] = [];
      try {
        images = JSON.parse(this.getAttribute('data-images') || '[]') as string[];
      } catch {
        return;
      }
      if (!images.length) return;

      const img = dialog.querySelector<HTMLImageElement>('[data-aw-brand-img]');
      const counter = dialog.querySelector<HTMLElement>('[data-aw-brand-counter]');
      if (!img) return;

      let current = 0;
      const show = (index: number) => {
        current = (index + images.length) % images.length;
        img.src = images[current];
        if (counter) counter.textContent = `${current + 1} / ${images.length}`;
      };

      this.querySelectorAll<HTMLButtonElement>('[data-aw-brand-open]').forEach((button, index) =>
        button.addEventListener('click', () => {
          show(index);
          dialog.showModal();
        })
      );

      dialog.querySelector('[data-aw-brand-prev]')?.addEventListener('click', () => show(current - 1));
      dialog.querySelector('[data-aw-brand-next]')?.addEventListener('click', () => show(current + 1));
      dialog.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') show(current - 1);
        if (event.key === 'ArrowRight') show(current + 1);
      });
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    }
  }

  if (!customElements.get('aw-brand-gallery')) customElements.define('aw-brand-gallery', AwBrandGallery);
</script>
