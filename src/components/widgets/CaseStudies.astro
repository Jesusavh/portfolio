---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import PhoneMockup from '~/components/widgets/PhoneMockup.astro';
import { Icon } from 'astro-icon/components';
import { cases } from '~/data/cases';

/**
 * Casos de éxito: grid de tarjetas con mockup de celular (feed o reel)
 * + métricas destacadas (alcance, engagement, conversión).
 */
interface Props {
  id?: string;
  tagline?: string;
  title?: string;
  subtitle?: string;
}

const { id = 'casos', tagline = 'Casos de éxito', title, subtitle } = Astro.props;
---

<WidgetWrapper id={id} containerClass="max-w-6xl">
  <Headline
    tagline={tagline}
    title={title ?? 'Resultados reales, historias reales'}
    subtitle={subtitle ?? 'Mockups de contenido y métricas de cada proyecto. Toca el teléfono, imagina el resultado.'}
  />

  <div class="mx-auto grid max-w-5xl gap-10">
    {
      cases.map(({ client, sector, summary, media, kpis, result }, index) => (
        <article
          class="grid items-center gap-10 md:grid-cols-[minmax(0,16rem)_1fr] md:gap-12 intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
          style={`animation-delay: ${(index % 3) * 90}ms`}
        >
          <PhoneMockup media={media} />

          <div class="rounded-3xl bg-white/70 p-6 shadow-sm ring-1 ring-black/5 sm:p-8 dark:bg-slate-900/50 dark:ring-white/10">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
              <h3 class="font-heading text-2xl font-bold tracking-tight text-heading dark:text-white">{client}</h3>
              <span class="rounded-full bg-primary/10 px-3 py-0.5 text-xs font-semibold uppercase tracking-wide text-primary dark:bg-primary/20 dark:text-pink-100">
                {sector}
              </span>
            </div>

            <p class="mt-3 text-base text-muted dark:text-slate-300">{summary}</p>

            <ul class="mt-6 grid grid-cols-3 gap-3">
              {kpis.map(({ label, value }) => (
                <li class="rounded-2xl bg-primary/5 px-2 py-4 text-center ring-1 ring-primary/10">
                  <span class="block font-heading text-xl font-bold tabular-nums text-accent sm:text-2xl dark:text-pink-200">
                    {value}
                  </span>
                  <span class="mt-0.5 block text-[0.7rem] font-medium uppercase tracking-wider text-muted sm:text-xs">
                    {label}
                  </span>
                </li>
              ))}
            </ul>

            <p class="mt-5 flex items-center gap-2 text-sm font-semibold text-secondary">
              <Icon name="tabler:trending-up" class="h-5 w-5" />
              {result}
            </p>
          </div>
        </article>
      ))
    }
  </div>
</WidgetWrapper>
