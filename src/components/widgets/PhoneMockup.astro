---
import { ik } from '~/constants';
import CldVideo from '~/components/CldVideo.astro';

/**
 * Marco de smartphone responsive para feeds de Instagram o reels verticales.
 * - Imágenes: lazy loading nativo + ImageKit.
 * - Vídeos: servidos desde Cloudinary (f_auto, q_auto, w_720) con carga
 *   diferida (IntersectionObserver) y autoplay/muted/loop.
 */
type PhoneMedia = { type: 'image'; path: string; alt?: string } | { type: 'video'; publicId: string; alt?: string };

interface Props {
  media: PhoneMedia;
  className?: string;
}

const { media, className = '' } = Astro.props;

const width = 720;
const imageUrl = media.type === 'image' ? ik(media.path, { w: width }) : undefined;
---

<div
  class:list={[
    'relative mx-auto w-[218px] sm:w-[248px] aspect-[9/19] rounded-[2.6rem] bg-neutral-900 p-[10px] shadow-2xl ring-1 ring-black/10 dark:ring-white/10',
    className,
  ]}
>
  <span class="absolute -left-[3px] top-24 h-10 w-[3px] rounded-l-md bg-neutral-700" aria-hidden="true"></span>
  <span class="absolute -left-[3px] top-36 h-14 w-[3px] rounded-l-md bg-neutral-700" aria-hidden="true"></span>
  <span class="absolute -right-[3px] top-28 h-12 w-[3px] rounded-r-md bg-neutral-700" aria-hidden="true"></span>
  <div class="relative h-full w-full overflow-hidden rounded-[2.1rem] bg-black/5 dark:bg-black">
    {
      media.type === 'video' ? (
        <CldVideo
          src={media.publicId}
          width={width}
          autoplay
          loop
          muted
          playsinline
          preload="none"
          lazy
          tabindex="-1"
          aria-hidden="true"
          class="absolute inset-0 h-full w-full object-cover"
        />
      ) : (
        <img
          src={imageUrl}
          alt={media.alt}
          loading="lazy"
          decoding="async"
          width={width}
          class="absolute inset-0 h-full w-full object-cover"
        />
      )
    }
    <span
      class="absolute left-1/2 top-[7px] h-[22px] w-[86px] -translate-x-1/2 rounded-full bg-neutral-800"
      aria-hidden="true"></span>
    <span class="absolute bottom-1.5 left-1/2 h-[4px] w-24 -translate-x-1/2 rounded-full bg-white/70" aria-hidden="true"
    ></span>
  </div>
</div>
