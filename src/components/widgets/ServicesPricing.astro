---
import Button from '~/components/ui/Button.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import ServiceCard from '~/components/widgets/ServiceCard.astro';
import { videoPlans, services } from '~/data/services';
import { whatsappLink } from '~/data/contact';

/**
 * Servicios: los planes de producción/edición de video se muestran
 * destacados arriba y el resto de servicios en un grid 2x2 debajo,
 * seguido de un banner de llamado a la acción unificado.
 */
interface Props {
  id?: string;
  tagline?: string;
  title?: string;
  subtitle?: string;
}

const { id = 'servicios', tagline = 'Servicios', title, subtitle } = Astro.props;
---

<WidgetWrapper id={id} containerClass="max-w-6xl">
  <Headline
    tagline={tagline}
    title={title ?? 'Cómo puedo ayudarte a crecer'}
    subtitle={subtitle ?? 'Planes claros con un desglose de entregables: elige el que tu marca necesita.'}
  />

  <!-- Planes de video (destacados) -->
  <div class="mx-auto grid max-w-4xl gap-6 md:grid-cols-2">
    {
      videoPlans.map((plan, index) => (
        <div
          class="h-full intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
          style={`animation-delay: ${index * 90}ms`}
        >
          <ServiceCard service={plan} featured />
        </div>
      ))
    }
  </div>

  <!-- Otros servicios (grid 2x2) -->
  <div class="mt-16">
    <div class="mb-8 flex items-center gap-4">
      <h3 class="font-heading text-2xl font-bold tracking-tight text-heading dark:text-white">Otros servicios</h3>
      <span class="h-px flex-1 bg-black/10 dark:bg-white/10" aria-hidden="true"></span>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      {
        services.map((service, index) => (
          <div
            class="h-full intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
            style={`animation-delay: ${(index % 2) * 90}ms`}
          >
            <ServiceCard service={service} />
          </div>
        ))
      }
    </div>
  </div>

  <!-- Banner CTA unificado -->
  <div
    class="mt-12 rounded-3xl bg-white/70 p-8 text-center shadow-sm ring-1 ring-black/5 sm:p-10 dark:bg-slate-900/50 dark:ring-white/10"
  >
    <p class="text-lg font-medium text-heading dark:text-white">
      ¿Buscas una propuesta integral o combinar varios de estos servicios para tu marca?
    </p>
    <div class="mt-6 flex justify-center">
      <Button variant="primary" href={whatsappLink} target="_blank" icon="tabler:arrow-right">
        Armemos un plan a tu medida
      </Button>
    </div>
  </div>
</WidgetWrapper>
